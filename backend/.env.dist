DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
WEBHOOK_URL=
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=patron-local
# Point at MinIO for local dev; remove for real S3
AWS_S3_HOST=http://localhost:9000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=
AUTH_SECRET_KEY=
APPLICATION_FRONTEND_URL=http://localhost:5173
APPLICATION_BACKEND_URL=http://localhost:8080
# Local dev: Mailpit (docker compose up mailpit), UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM_ADDRESS=dev@localhost
COOKIE_SECURE=false
OUTRANK_ACCESS_TOKEN=

# --- Single-creator mode ---
# The account with this email is promoted to the site's creator (admin)
CREATOR_EMAIL=

# --- Stripe (test mode for local dev) ---
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8080/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# --- Web Push (generate once: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost
